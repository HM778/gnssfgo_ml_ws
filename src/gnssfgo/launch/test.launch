<launch>
    <arg name="osqa_enabled" default="false" />
    <node name="SANode" pkg="gnssfgo" type="SANode" output="screen" >
        <param name="hotstart_enable" value="false" />
        <param name="GPS/BDS_only" value="false" />
        <param name="wls_llh_topic" value="/trbin/psr_llh" />
        <param name="wls_enu_topic" value="/trbin/psr_enu" />
        <param name="fgo_llh_topic" value="/trbin/fgo_llh" />
        <param name="fgo_enu_topic" value="/trbin/fgo_enu" />
        <param name="output_file" value="c099.csv" />
        <param name="windowSize" value="10" />
        <param name="marginal_enable" value="false" />
        <param name="history_epoch_window" value="200" />
        <param name="max_running_time_ms" value="50.0" />
        <param name="same_time_weight" value="false" />
        <param name="same_reliable" value="false" />
        <param name="osqa_enabled" value="$(arg osqa_enabled)"/>
        <param name="osqa_input_path" value="$(env HOME)/Work/gnssfgo_ml_ws/osqa_input.jsonl"/>
        <param name="osqa_output_path" value="$(env HOME)/Work/gnssfgo_ml_ws/osqa_output.jsonl"/>
        <param name="osqa_quality_threshold" value="0.3"/>
        <param name="max_psr_factors_per_epoch" value="24" />
        <param name="min_tr_factor_num" value="20" />
    </node>

</launch>